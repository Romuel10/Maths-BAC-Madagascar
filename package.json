{
  "name": "maths-bac-madagascar",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/offline.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:ui": "node tests/interface.mjs",
    "test:full": "npm test && npm run build && npm run test:ui",
    "cap:sync": "npm run build && cap sync android",
    "android:debug": "npm run cap:sync && cd android && bash ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/share": "8.0.3",
    "@fontsource/manrope": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "katex": "0.19.0",
    "mathjs": "15.2.0",
    "nerdamer": "2.0.0",
    "react": "19.2.6",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@types/katex": "0.16.8",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "playwright": "1.62.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
